# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Mode Développement / Sécurité 2FA (Prompt 18 & Prompt 17-O Fix)
# Mettre à true pour désactiver la double authentification en local
DISABLE_2FA=false
DEBUG_2FA=true

# Service d'envoi d'e-mails (Option 1 : Resend API)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="Novika Sécurité <securite@novika.africa>"

# Service d'envoi d'e-mails (Option 2 : SMTP Gmail)
# Note : Pour Gmail, générer un mot de passe d'application sur myaccount.google.com/apppasswords
GMAIL_USER=promisesbedi@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Service d'envoi d'e-mails (Option 3 : SMTP Standard / Serveur Dédié)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=promisesbedi@gmail.com
# SMTP_PASS=your_app_password
